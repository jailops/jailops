{
  "name": "jailops-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">= 22" },
  "workspaces": ["shared", "host", "backup"],
  "scripts": {
    "build": "node scripts/app.mjs build",
    "build:all": "node scripts/app.mjs build --all",
    "dev": "node scripts/app.mjs dev",
    "typecheck": "node scripts/app.mjs typecheck --all",
    "test": "vitest run",
    "test:all": "vitest run",
    "e2e": "node scripts/app.mjs e2e",
    "e2e:all": "node scripts/app.mjs e2e --all",
    "new-app": "node scripts/new-app.mjs",
    "gen": "cd .. && go run ./scripts/gen-ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "typescript": "~7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
