$ jailops network rename office Bad_Name -y
! invalid: invalid name "Bad_Name"
! hint: the name rule of the kind's create applies
[exit 2]

$ jailops firewall address-set rename office hq -y
address set/office renamed to hq (1 reference changed)

$ jailops firewall policy rename web public -y
firewall policy/web renamed to public (1 reference changed)

$ jailops start web
jail/web started

$ jailops rename web www -y
! busy: jail "web" is running
! hint: stop it first (jailops stop web); a jail is renamed while it is stopped
[exit 5]

$ jailops stop web
jail/web stopped

$ jailops rename web www -y
jail/web renamed to www (1 reference, 1 dataset changed)

$ jailops jail rename www web -y -o json
