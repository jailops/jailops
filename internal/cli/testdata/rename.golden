$ jailops jail create web --image freebsd-15@stable --network lan --storage default --firewall-policy web
jail/web created

$ jailops jail create db --image freebsd-15@stable --network lan --storage default --depends web
jail/db created

$ jailops network rename lan office --dry-run
dry-run: would rename network lan to office
  object     network lan: renamed to office
  reference  project main: spec.networks: lan -> office
  reference  jail db (project main): spec.network[0].network: lan -> office
  reference  jail web (project main): spec.network[0].network: lan -> office
steps:
  01 network lan: renamed to office
  02 project main: spec.networks: lan -> office
  03 jail db (project main): spec.network[0].network: lan -> office
  04 jail web (project main): spec.network[0].network: lan -> office

$ jailops network rename lan office
