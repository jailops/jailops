$ jailops jail list -o yaml
- metadata:
    name: web
    uuid: <uuid>
    project: main
    host: <uuid>
    scope: host
    generation: 1
    labels:
      env: prod
    created_at: "2026-03-01T09:00:00Z"
    updated_at: "2026-03-01T09:00:00Z"
  spec:
    image: freebsd-15@stable
    storage: default
    layout: thin
    hostname: web
    network:
      - network: lan
        ipv4: 10.20.0.10
  status:
    power: stopped
    generation: g1

