$ jailops info db -o yaml
name: db
project: main
uuid: <uuid>
hostname: db
state: stopped
layout: thin
image: freebsd-15@stable
generation: g1
storage: default
created_at: "2026-03-01T09:00:00Z"
resources:
  usage:
    jail: db
    power: stopped
    measured_at: "2026-03-01T09:00:00Z"
    disk:
      root_bytes: 268435456
      root_referenced_bytes: 1610612736
      data_bytes: 73400320
interfaces:
  - name: eth0
    network: lan
    state: down
    addresses:
      - address: 10.20.0.11
        family: ipv4
        scope: global
        configured: false
  - name: eth1
    network: sw
    state: down
    addresses:
      - address: 10.94.0.2
        family: ipv4
        scope: global
        configured: false
      - address: 2001:db8:1:2:100::10
        family: ipv6
        scope: global
        configured: false
volumes:
  - name: data
    mount: /var/db
snapshots:
  count: 2
  newest: after
  newest_at: "2026-03-01T09:00:00Z"

