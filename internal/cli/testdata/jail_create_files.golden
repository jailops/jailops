$ jailops jail create -f <dir>/env.yaml
jail/web created

$ jailops jail create bare -f <dir>/bare.yaml
jail/bare created

$ jailops jail create -f <dir>/multi.yaml
jail/m1 created
jail/m2 created

$ jailops jail create -f <dir>/bare.yaml
! usage: a bare spec needs a name: pass NAME on the command line
! hint: run 'jailops jail create --help' for usage
[exit 2]

$ jailops jail create x -f <dir>/typo.yaml
! usage: unknown field "memmory"
! hint: run 'jailops jail create --help' for usage
[exit 2]

$ jailops jail create -f <dir>/wk.yaml
! usage: the document is a Network, but this command handles Jail
! hint: run 'jailops jail create --help' for usage
[exit 2]

$ jailops jail create web -f <dir>/env.yaml
! already_exists: jail "web" already exists
! hint: Pick another name, or edit the existing object. (jailops explain already_exists)
[exit 5]

$ jailops jail create -f -
jail/viastdin created

$ jailops jail show web -o yaml
metadata:
  name: web
  uuid: <uuid>
  project: main
  host: <uuid>
  scope: host
