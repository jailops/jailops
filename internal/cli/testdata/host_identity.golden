$ jailops host restore --dry-run
--- host
+++ host
-ntp servers 192.0.2.123
+ntp servers (none)
dry-run: would
  set ntp servers to (none)

$ jailops -y host restore
--- host
+++ host
-ntp servers 192.0.2.123
+ntp servers (none)
  set ntp servers to (none)
host restore: done; undo with: jailops host restore 20260301T090000Z-3

$ jailops -y host restore ../etc
