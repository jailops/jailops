$ jailops logs forward add gelf --to udp://h
! usage: TYPE is syslog or webhook, not "gelf"
! hint: run 'jailops logs forward add --help' for usage
[exit 2]

$ jailops logs forward add syslog
! usage: --to is required: where the sink sends (tls://logs.example.com:6514, https://hooks.example.com/x)
! hint: run 'jailops logs forward add --help' for usage
[exit 2]

$ jailops logs forward add syslog --to udp://h --name logs
! already_exists: sink "logs" already exists
! hint: change it with: jailops logs forward edit logs
[exit 5]

$ jailops logs forward edit nope --facility local1
! not_found: sink "nope" not found
! hint: list them with: jailops logs forward list
[exit 4]

$ jailops logs forward edit logs
! usage: nothing to change: give the flags to change
! hint: run 'jailops logs forward edit --help' for usage
[exit 2]

