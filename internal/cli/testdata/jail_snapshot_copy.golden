$ jailops jail create web --image freebsd-15@stable --storage default --network lan=10.20.0.15
jail/web created

$ jailops jail snapshot create web s1 -m first
snapshot/s1 created

$ jailops jail snapshot create web s2
snapshot/s2 created

$ jailops jail snapshot list web
NAME   WRITTEN   AGE   COMMENT
s1     0 B       3h    first
s2     3.0 MiB   3h    -

$ jailops jail snapshot delete web s1
! Delete snapshot "s1" of jail "web"? [y/N]: 
! usage: confirmation required
! hint: answer on standard input, or pass -y
[exit 2]

$ jailops jail snapshot delete -y web s1
snapshot/s1 deleted

$ jailops jail snapshot delete web s2
snapshot/s2 deleted
! Delete snapshot "s2" of jail "web"? [y/N]: 

$ jailops jail copy web web2
jail/web2 created

$ jailops jail show web2 -o json
{
  "metadata": {
    "name": "web2",
    "uuid": "<uuid>",
    "project": "main",
    "host": "<uuid>",
    "scope": "host",
    "generation": 1,
    "created_at": "2026-03-01T09:00:00Z",
    "updated_at": "2026-03-01T09:00:00Z"
  },
  "spec": {
    "image": "freebsd-15@stable",
    "storage": "default",
    "layout": "thin",
    "hostname": "web",
    "update": {},
    "resources": {},
    "network": [
      {
        "network": "lan",
        "ipv4": "10.20.0.10"
      }
    ],
    "firewall": {},
    "boot": {}
  },
  "status": {
    "power": "stopped",
    "generation": "g1"
  }
}

$ jailops jail copy web web3 --keep-ip --dry-run
dry-run: would copy jail web to web3
apiVersion: jailops/v1
kind: Jail
metadata:
  name: web3
spec:
  image: freebsd-15@stable
  storage: default
  layout: thin
  hostname: web
  network:
    - network: lan
      ipv4: 10.20.0.15

$ jailops jail copy web web2
! already_exists: jail "web2" already exists
! hint: Pick another name, or edit the existing object. (jailops explain already_exists)
[exit 5]

$ jailops jail exec web -- ls
! busy: jail "web" is not running
! hint: Wait for the running operation ('jailops op list') and retry. (jailops explain busy)
[exit 5]

$ jailops jail console web
! busy: jail "web" is not running
! hint: Wait for the running operation ('jailops op list') and retry. (jailops explain busy)
[exit 5]

