$ jailops create n2 --project web --image freebsd-15@stable --memory 1G --cpu 1 --network br-web --storage fast
jail/n2 created

$ jailops create n3 --project web --image freebsd-15@stable --memory 1G --cpu 1 --network br-web --storage fast
! quota_exceeded: project "web" would exceed its jails quota (3 of 2)
! hint: See the usage with 'jailops project show NAME', free something up, or ask a global admin to raise the quota with 'jailops project set NAME --max-...'. (jailops explain quota_exceeded)
[exit 5]

$ jailops project delete -y web
! busy: project "web" is not empty
! hint: delete its jails, policies, address sets and backup policies first
[exit 5]

$ jailops project delete -y default
! not_found: project "default" not found
! hint: List the kind to see the names, check --host and --remote, and check the spelling. (jailops explain not_found)
[exit 4]

