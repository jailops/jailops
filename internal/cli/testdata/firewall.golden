$ jailops firewall address-set create office --address 192.0.2.0/24 --address 198.51.100.7
address set/office created

$ jailops firewall address-set create empty
! usage: give at least one --address (or use -f FILE)
! hint: run 'jailops firewall address-set create --help' for usage
[exit 2]

$ jailops firewall address-set create hq --address 192.0.2.9 --comment the office
address set/hq created

$ jailops firewall address-set show hq -o yaml
metadata:
  name: hq
  uuid: <uuid>
  project: main
  scope: fleet
  generation: 1
  created_at: "2026-03-01T09:00:00Z"
  updated_at: "2026-03-01T09:00:00Z"
spec:
  addresses:
    - address: 192.0.2.9
      comment: the office

$ jailops firewall address-set show hq
Address set hq
  Age:      3h

MEMBER      COMMENT
192.0.2.9   the office

$ jailops firewall policy create documented --default-in deny --default-out allow --comment the public web server --rule allow in tcp port 80,443 comment the site --rule allow in tcp from @hq port 22 comment ssh from the office
firewall policy/documented created

$ jailops firewall policy show documented -o yaml
metadata:
  name: documented
  uuid: <uuid>
  project: main
  scope: fleet
  generation: 1
  created_at: "2026-03-01T09:00:00Z"
  updated_at: "2026-03-01T09:00:00Z"
spec:
  comment: the public web server
  default_in: deny
  default_out: allow
  rules:
    - comment: the site
      action: allow
      direction: in
      proto: tcp
      ports:
        - "80"
        - "443"
    - comment: ssh from the office
      action: allow
      direction: in
      proto: tcp
      from:
        - '@hq'
      ports:
        - "22"

$ jailops firewall policy show documented
Firewall policy documented
  Comment:      the public web server
  Default in:   deny
  Default out:  allow
  Age:          3h

#   RULE                            COMMENT
1   allow in tcp port 80,443        the site
2   allow in tcp from @hq port 22   ssh from the office

$ jailops firewall policy create switchable --rule allow in tcp port 80 comment the site --rule allow in tcp port 22 disabled comment ssh, switched off --rule deny in tcp port 23 disabled
firewall policy/switchable created

$ jailops firewall policy show switchable
Firewall policy switchable
  Default in:   deny
  Default out:  allow
  Age:          3h

#   RULE                            COMMENT
1   allow in tcp port 80            the site
2   allow in tcp port 22 disabled   ssh, switched off
3   deny in tcp port 23 disabled    -

$ jailops firewall policy show switchable -o yaml
metadata:
  name: switchable
  uuid: <uuid>
  project: main
  scope: fleet
  generation: 1
  created_at: "2026-03-01T09:00:00Z"
  updated_at: "2026-03-01T09:00:00Z"
spec:
  default_in: deny
  default_out: allow
  rules:
    - comment: the site
      action: allow
      direction: in
      proto: tcp
      ports:
        - "80"
    - comment: ssh, switched off
      action: allow
      direction: in
      proto: tcp
      ports:
        - "22"
      disabled: true
    - action: deny
      direction: in
      proto: tcp
      ports:
        - "23"
      disabled: true

$ jailops firewall policy create nocomment --default-in deny --default-out allow --rule allow in tcp port 80 comment
! usage: rule "allow in tcp port 80 comment": comment needs a text
! hint: run 'jailops firewall policy create --help' for usage
[exit 2]

$ jailops firewall policy create nodefaults --rule allow in tcp port 80
firewall policy/nodefaults created

$ jailops firewall address-set create c1 --comment no address
! usage: give at least one --address (or use -f FILE)
! hint: run 'jailops firewall address-set create --help' for usage
[exit 2]

$ jailops firewall address-set create c2 --address 192.0.2.2 --address 192.0.2.3 --comment which one
! usage: --comment describes a single --address; for several entries with comments use a file (-f FILE) or 'address-set edit'
! hint: run 'jailops firewall address-set create --help' for usage
[exit 2]

$ jailops firewall policy create web --default-in deny --default-out allow --rule allow in tcp port 80,443 --rule allow in tcp from @office port 22 log --rule allow in tcp port 8080 rdr 8080:80
firewall policy/web created

$ jailops firewall policy create bad --default-in deny --default-out allow --rule allow
! usage: rule "allow" needs at least ACTION and DIRECTION
! hint: run 'jailops firewall policy create --help' for usage
[exit 2]

$ jailops firewall policy create bad2 --default-in deny --default-out allow --rule allow in tcp bogus 1
! usage: rule "allow in tcp bogus 1": unknown word "bogus"
! hint: run 'jailops firewall policy create --help' for usage
[exit 2]

$ jailops firewall policy list
NAME         DEFAULT-IN   DEFAULT-OUT   RULES   RAW
documented   deny         allow         2       no
nodefaults   deny         allow         1       no
switchable   deny         allow         3       no
web          deny         allow         3       no

$ jailops firewall policy show web
Firewall policy web
  Default in:   deny
  Default out:  allow
  Age:          3h

#   RULE                                    COMMENT
1   allow in tcp port 80,443                -
2   allow in tcp from @office port 22 log   -
3   allow in tcp port 8080 rdr 8080:80      -

