$ jailops firewall validate -f <dir>/good.yaml
valid: 2 documents checked

$ jailops firewall validate -f <dir>/good.yaml --offline
valid: 2 documents checked

$ jailops firewall validate -f <dir>/bad.yaml
! usage: cannot use string into AddressSetSpec.addresses.0 of type api.AddressEntry
! hint: run 'jailops firewall validate --help' for usage
[exit 2]

$ jailops firewall validate -f <dir>/bad.yaml -o json
! usage: cannot use string into AddressSetSpec.addresses.0 of type api.AddressEntry
! hint: run 'jailops firewall validate --help' for usage
[exit 2]

$ jailops firewall validate
! usage: -f FILE is required
! hint: run 'jailops firewall validate --help' for usage
[exit 2]

$ jailops firewall validate -f <dir>/j.yaml
! usage: validate handles FirewallPolicy and AddressSet documents, not "Jail"
! hint: run 'jailops firewall validate --help' for usage
[exit 2]

$ jailops firewall policy edit web -f <dir>/p.yaml
firewall policy/web updated

$ jailops firewall policy delete -y web
firewall policy/web deleted

$ jailops firewall address-set delete -y office
address set/office deleted

