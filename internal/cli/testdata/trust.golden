[exit 2]

$ jailops trust list
NAME     KIND     PERMISSION   SCOPE   EXPIRES   FINGERPRINT
laptop   client   operator     web     never     <fingerprint>

$ jailops trust show laptop
metadata:
  name: laptop
  uuid: <uuid>
  scope: fleet
  generation: 1
  created_at: "2026-03-01T09:00:00Z"
  updated_at: "2026-03-01T09:00:00Z"
spec:
  fingerprint: <sha256>
  permission: operator
  kind: client
  projects:
    - web

$ jailops trust edit laptop -f <dir>/e.yaml
certificate/laptop updated

$ jailops whoami
User:        admin
Kind:        token
Role:        admin
Scope:       global
Remote:      adm (https://<addr>)
Project:     

$ jailops trust revoke laptop
! Revoke trust of "laptop"? [y/N]: 
! usage: confirmation required
! hint: answer on standard input, or pass -y
[exit 2]

$ jailops trust revoke -y laptop
certificate/laptop revoked

$ jailops trust list
! No resources found.

$ jailops trust revoke -y laptop
! not_found: certificate "laptop" not found
! hint: List the kind to see the names, check --host and --remote, and check the spelling. (jailops explain not_found)
[exit 4]

$ jailops sessions list
! No resources found.

$ jailops sessions revoke -y nosuch
