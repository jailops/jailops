$ jailops create web --image freebsd-15 --network lan --storage default
jail/web created

$ jailops jail repair-packages web
jail/web: the 0 base package records are in step with the image

$ jailops jail repair-packages web -o json
{
  "jail": "web",
  "base": 0,
  "replaced": 0,
  "added": 0
}

$ jailops --dry-run jail repair-packages web
dry-run: would repair the base package records of jail web
{}

$ jailops start web
jail/web started

$ jailops jail repair-packages web
! busy: jail "web" is running; its base package records are repaired while it is stopped, and by every start
! hint: restart it: jailops restart web
[exit 5]

$ jailops jail repair-packages ghost
! not_found: jail "ghost" not found
! hint: list them with 'jailops jail list'; check --project, --host and --remote too
[exit 4]

