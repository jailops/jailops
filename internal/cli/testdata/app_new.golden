$ jailops app new quiet --dir <dir>/apps -q

$ jailops app new Bad_Name --dir <dir>/apps
! usage: "Bad_Name" is not an app name: lower case letters, digits and dashes, starting with a letter, at most 63 characters
! hint: run 'jailops app new --help' for usage
[exit 2]

$ jailops app new x --port http --dir <dir>/apps
! usage: port "http" must be N or N/tcp or N/udp, with N from 1 to 65535
! hint: run 'jailops app new --help' for usage
[exit 2]

