$ jailops image create alpine-3 --os linux --release 3.22 --source-type minirootfs --alias latest
image/alpine-3 created

$ jailops image create bad
! usage: --release is required (or use -f FILE)
! hint: run 'jailops image create --help' for usage
[exit 2]

$ jailops image list
NAME         OS        RELEASE        ARCH    GENERATIONS   ALIASES
alpine-3     linux     3.22           amd64   0             latest
freebsd-15   freebsd   15.0-RELEASE   amd64   1             stable

$ jailops image show freebsd-15
Name:        freebsd-15
UUID:        <uuid>
Generation:  1
Age:         3h

SPEC                     STATUS
----                     ------
os: freebsd              generations:
release: 15.0-RELEASE      - number: 1
arch: amd64                  name: freebsd-15#g1
source:                      manifest: sha256:<hex>
  type: pkgbase              created_at: "2026-03-01T09:00:00Z"
aliases:                 aliases:
  - stable                 stable: 1

$ jailops image build freebsd-15
generation/freebsd-15#g2 built

$ jailops image generations freebsd-15
NAME            NUMBER   PARENT   PACKAGES   MANIFEST              AGE   USED BY
freebsd-15#g1   1        -        0          sha256:<hex>   3h    -
freebsd-15#g2   2        -        120        sha256:<hex>   3h    -

$ jailops image build freebsd-15 --dry-run
dry-run: would build freebsd-15#g3 (120 packages)

$ jailops image build freebsd-15 --from g1
generation/freebsd-15#g3 built

$ jailops image build freebsd-15 --from x
! usage: --from must be a generation such as g2, not "x"
! hint: run 'jailops image build --help' for usage
[exit 2]

$ jailops image generations freebsd-15 -o name
freebsd-15#g1
freebsd-15#g2
freebsd-15#g3

$ jailops image alias set freebsd-15 edge
image/freebsd-15 alias edge set to g3

$ jailops image alias set freebsd-15 stable g1
image/freebsd-15 alias stable set to g1

$ jailops image alias set freebsd-15 stable 9
! not_found: generation "9" not found
! hint: List the kind to see the names, check --host and --remote, and check the spelling. (jailops explain not_found)
[exit 4]

$ jailops image alias set freebsd-15 stable x
! usage: GENERATION must be a generation such as g2, not "x"
! hint: run 'jailops image alias set --help' for usage
[exit 2]

