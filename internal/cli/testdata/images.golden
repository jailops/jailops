$ jailops image alias delete -y freebsd-15 edge
image/freebsd-15 alias edge deleted

$ jailops image alias delete -y freebsd-15 edge
! not_found: alias "edge" not found
! hint: List the kind to see the names, check --host and --remote, and check the spelling. (jailops explain not_found)
[exit 4]

$ jailops image list -o name
alpine-3
freebsd-15

$ jailops jail create web --image freebsd-15#g1 --network lan --storage default
jail/web created

$ jailops image delete-generation -y freebsd-15 1
! image_in_use: generation g1 is used by jail web
! hint: upgrade or destroy those jails first
[exit 5]

$ jailops image alias set freebsd-15 latest
image/freebsd-15 alias latest set to g3

$ jailops image delete-generation -y freebsd-15 3
generation/freebsd-15#g3 deleted

$ jailops image show freebsd-15
Name:        freebsd-15
UUID:        <uuid>
