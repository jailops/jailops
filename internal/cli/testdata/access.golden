$ jailops token create ci --permission operator --projects main --expires 720h --allow-from 10.0.0.0/8
<token>
! warning: this secret is shown only once and cannot be retrieved again; store it now.

$ jailops token create j --global -o json
{
  "metadata": {
    "name": "j",
    "uuid": "<uuid>",
    "scope": "fleet",
    "generation": 1,
    "created_at": "2026-03-01T09:00:00Z",
    "updated_at": "2026-03-01T09:00:00Z"
  },
  "spec": {
    "permission": "readonly",
    "global": true
  },
  "secret": "<token>"
}
! warning: this secret is shown only once and cannot be retrieved again; store it now.

$ jailops token list
NAME   PERMISSION   SCOPE    EXPIRES      ALLOW-FROM   AGE
ci     operator     main     2026-03-31   10.0.0.0/8   3h
j      readonly     global   never        -            3h

$ jailops token list -o json
[
  {
    "metadata": {
      "name": "ci",
      "uuid": "<uuid>",
      "scope": "fleet",
