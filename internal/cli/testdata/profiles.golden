$ jailops profile create base --comment defaults --set resources.memory=1G --set boot.autostart=true
profile/base created

$ jailops profile create web --set resources.memory=4G --set network.eth1=lan
profile/web created

$ jailops profile create bad --set hostname=x
! invalid: hostname cannot be set in a profile
[exit 2]

$ jailops profile create bad2 --set nonsense=1
! usage: "nonsense" is not a configuration key (see 'jailops config keys')
! hint: run 'jailops profile create --help' for usage
[exit 2]

$ jailops profile create bad3 --set resources.memory
! usage: --set "resources.memory" must be KEY=VALUE
! hint: run 'jailops profile create --help' for usage
[exit 2]

$ jailops profile list
NAME   KEYS   COMMENT
base   2      defaults
web    2      -

$ jailops profile show web
metadata:
  name: web
  uuid: <uuid>
  project: main
  scope: fleet
  generation: 1
  created_at: "2026-03-01T09:00:00Z"
  updated_at: "2026-03-01T09:00:00Z"
spec:
  config:
    network.eth1: lan
    resources.memory: 4G

$ jailops create nginx --image freebsd-15 --network lan --storage default --profile base --profile web
jail/nginx created

$ jailops config set nginx resources.memory 8G
jail/nginx configuration updated
restart required for: resources.memory
the jail was not restarted: run 'jailops restart nginx' when it suits you, or repeat with --restart

$ jailops config show nginx --expanded
KEY                    VALUE        SOURCE
boot.autostart         true         base
hostname               nginx        jail
image                  freebsd-15   jail
network.eth0           lan          jail
network.eth0.ipv4      10.20.0.10   jail
network.eth0.network   lan          jail
network.eth1           lan          web
network.eth1.network   lan          web
profiles               base,web     jail
resources.memory       8G           jail
storage                default      jail

$ jailops config show nginx
KEY                    VALUE
hostname               nginx
image                  freebsd-15
network.eth0           lan
network.eth0.ipv4      10.20.0.10
network.eth0.network   lan
profiles               base,web
resources.memory       8G
storage                default

$ jailops profile edit base -f <dir>/p.yaml
profile/base updated

$ jailops config show nginx --expanded -o json
