$ jailops jail apply web
! usage: name the recipe: -f FILE
! hint: run 'jailops jail apply --help' for usage
[exit 2]

$ jailops jail apply ghost -f <dir>/recipe.yaml
! not_found: jail "ghost" not found
! hint: list them with 'jailops jail list'; check --project, --host and --remote too
[exit 4]

$ jailops jail apply web -f <dir>/far.yaml
! usage: steps[0].file.source: ../x must be a path below the directory of the recipe
! hint: run 'jailops jail apply --help' for usage
[exit 2]

$ jailops jail apply web -f <dir>/etc.yaml
! invalid: steps[0].file.path: the path belongs to the base system: put local configuration below /usr/local/etc
[exit 2]

$ jailops jail apply web -f <dir>/typo.yaml
! usage: unknown field "pakage"
! hint: run 'jailops jail apply --help' for usage
[exit 2]

$ jailops provision web
! usage: unknown command "provision" for "jailops"
! hint: run 'jailops --help' for usage
[exit 2]

