$ jailops create web --image freebsd-15 --network lan --storage default
jail/web created

$ jailops jail apply web -f <dir>/recipe.yaml
! busy: jail "web" is not running; a recipe runs inside it
! hint: start it first
[exit 5]

$ jailops start web
jail/web started

$ jailops jail apply web -f <dir>/recipe.yaml
  package  nginx                                  changed
  file     /usr/local/etc/nginx/nginx.conf        changed
  sysrc    rc.conf                                changed
  service  nginx                                  changed
  run      /usr/local/sbin/nginx -t               executed
  run      pw useradd deploy                      changed
  6 steps: 5 changed, 1 executed; a run without creates or unless is executed every time

$ jailops jail apply web -f <dir>
  package  nginx                                  unchanged
  file     /usr/local/etc/nginx/nginx.conf        unchanged
  sysrc    rc.conf                                unchanged
  service  nginx                                  unchanged
  run      /usr/local/sbin/nginx -t               executed
  run      pw useradd deploy                      unchanged
  6 steps: 5 unchanged, 1 executed; a run without creates or unless is executed every time

$ jailops --dry-run jail apply web -f <dir>/recipe.yaml
jail/web: dry run, nothing was changed
  package  nginx                                  unchanged
  file     /usr/local/etc/nginx/nginx.conf        unchanged
  sysrc    rc.conf                                unchanged
  service  nginx                                  unchanged
  run      /usr/local/sbin/nginx -t               would execute
  run      pw useradd deploy                      would check
  6 steps: 4 unchanged, 1 would execute, 1 would check; a run without creates or unless is executed every time

