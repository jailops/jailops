$ jailops create nginx --image freebsd-15 --storage default --network lan
jail/nginx created

$ jailops start nginx
jail/nginx started

$ jailops config show nginx
KEY                    VALUE
hostname               nginx
image                  freebsd-15
network.eth0           lan
network.eth0.ipv4      10.20.0.10
network.eth0.network   lan
storage                default

$ jailops config set nginx resources.memory 2G resources.cpu 2
jail/nginx configuration updated
restart required for: resources.cpu, resources.memory
the jail was not restarted: run 'jailops restart nginx' when it suits you, or repeat with --restart

$ jailops config get nginx resources.memory
2G

$ jailops config get nginx resources.memory -o json
{
  "key": "resources.memory",
  "value": "2G"
}

$ jailops config get nginx resources.pids
! not_found: key "resources.pids" is not set on jail "nginx"
! hint: 'jailops config show nginx' lists the keys that are set
[exit 4]

$ jailops config get nginx no.such.key
! usage: "no.such.key" is not a configuration key (see 'jailops config keys')
! hint: run 'jailops config get --help' for usage
[exit 2]

$ jailops config set nginx resources.memory
! usage: key "resources.memory" has no value: write KEY VALUE or KEY=VALUE
! hint: run 'jailops config set --help' for usage
[exit 2]

$ jailops config set nginx resources.cpu many
! invalid: resources.cpu: "many" must be a number between 0 and 4096
[exit 2]

$ jailops config set nginx no.such.key 1
! usage: "no.such.key" is not a configuration key (see 'jailops config keys')
! hint: run 'jailops config set --help' for usage
[exit 2]

$ jailops config set nginx resources.cpu 4 resources.pids bad
! invalid: resources.pids: "bad" must be a number between 0 and 4194304
[exit 2]

$ jailops config get nginx resources.cpu
2

$ jailops config set nginx resources.pids=100 boot.autostart=true
jail/nginx configuration updated
restart required for: resources.pids
the jail was not restarted: run 'jailops restart nginx' when it suits you, or repeat with --restart

$ jailops config unset nginx resources.pids
jail/nginx configuration updated
restart required for: resources.pids
the jail was not restarted: run 'jailops restart nginx' when it suits you, or repeat with --restart

$ jailops config show nginx --expanded
KEY                    VALUE        SOURCE
boot.autostart         true         jail
hostname               nginx        jail
image                  freebsd-15   jail
network.eth0           lan          jail
network.eth0.ipv4      10.20.0.10   jail
network.eth0.network   lan          jail
resources.cpu          2            jail
resources.memory       2G           jail
storage                default      jail

$ jailops config show nginx -o yaml
- key: boot.autostart
  value: "true"
- key: hostname
  value: nginx
- key: image
  value: freebsd-15
- key: network.eth0
  value: lan
- key: network.eth0.ipv4
  value: 10.20.0.10
- key: network.eth0.network
  value: lan
- key: resources.cpu
  value: "2"
- key: resources.memory
  value: 2G
- key: storage
  value: default

$ jailops config keys limits
! No resources found.

$ jailops --dry-run config set nginx resources.cpu 8
dry-run: would update the configuration of jail nginx
restart_required:
  - resources.cpu
set:
  resources.cpu: "8"

$ jailops config get nginx resources.cpu
2

$ jailops config set nginx resources.pids 700
jail/nginx configuration updated
restart required for: resources.pids
the jail was not restarted: run 'jailops restart nginx' when it suits you, or repeat with --restart

$ jailops config set nginx resources.pids 800 --restart
jail/nginx configuration updated
jail/nginx restarted to apply: resources.pids

$ jailops config set nginx boot.priority 3 --restart
jail/nginx configuration updated

