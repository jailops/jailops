$ jailops firewall policy create floor --rule allow in tcp port 22
firewall policy/floor created

$ jailops firewall policy create monitoring --rule allow in tcp port 22
firewall policy/monitoring created

$ jailops firewall policy create postgres --rule allow in tcp port 22
firewall policy/postgres created

$ jailops firewall policy create ssh-office --rule allow in tcp port 22
firewall policy/ssh-office created

$ jailops jail create db --image freebsd-15@stable --storage default --network lan --firewall-policy postgres --firewall-policy ssh-office
jail/db created

$ jailops config get db firewall.policies
postgres,ssh-office

$ jailops config set db firewall.policies ssh-office,postgres
jail/db configuration updated

$ jailops config get db firewall.policies
ssh-office,postgres

$ jailops project set main --firewall-policy floor --firewall-policy monitoring
project/main updated

$ jailops project show main
Project main
  Hosts:       this host
  Networks:    lan
  Storage:     default
  Firewall:    floor, monitoring
  Images:      any
  Age:         3h

Usage
  Jails:       1 (no quota)
  CPU:         0 cores (no quota)
  Memory:      0 B (no quota)
  Disk:        0 B
  Addresses:   1 (no quota)

