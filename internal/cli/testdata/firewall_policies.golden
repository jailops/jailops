$ jailops firewall policy create floor
firewall policy/floor created

$ jailops firewall rule add floor in --action allow --proto tcp --port 22 --comment ssh
firewall policy/floor: rule 1 added: allow in tcp port 22
! note: without --from the rule is for the jail's link (the project's jails and the host); to let the Internet in name a source, --from any, or use: jailops expose JAIL PORTS

$ jailops firewall policy create monitoring
firewall policy/monitoring created

$ jailops firewall rule add monitoring in --action allow --proto tcp --port 22 --comment ssh
firewall policy/monitoring: rule 1 added: allow in tcp port 22
! note: without --from the rule is for the jail's link (the project's jails and the host); to let the Internet in name a source, --from any, or use: jailops expose JAIL PORTS

$ jailops firewall policy create postgres
firewall policy/postgres created

$ jailops firewall rule add postgres in --action allow --proto tcp --port 22 --comment ssh
firewall policy/postgres: rule 1 added: allow in tcp port 22
! note: without --from the rule is for the jail's link (the project's jails and the host); to let the Internet in name a source, --from any, or use: jailops expose JAIL PORTS

$ jailops firewall policy create ssh-office
firewall policy/ssh-office created

$ jailops firewall rule add ssh-office in --action allow --proto tcp --port 22 --comment ssh
firewall policy/ssh-office: rule 1 added: allow in tcp port 22
! note: without --from the rule is for the jail's link (the project's jails and the host); to let the Internet in name a source, --from any, or use: jailops expose JAIL PORTS

$ jailops jail create db --image freebsd-15 --storage default --network lan --firewall-policy postgres --firewall-policy ssh-office
jail/db created

$ jailops config get db firewall.policies
postgres,ssh-office

$ jailops config set db firewall.policies ssh-office,postgres
jail/db configuration updated

$ jailops config get db firewall.policies
ssh-office,postgres

$ jailops project set main --firewall-policy floor --firewall-policy monitoring
project/main updated

