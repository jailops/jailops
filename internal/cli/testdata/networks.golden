  ipv4:
    subnet: 10.94.0.0/24
    gateway: 10.94.0.1
    range: 10.94.0.2-10.94.0.254
  ipv6:
    mode: proxy
    subnet: 2001:db8:1:2:100::/80
    gateway: fe80::1
    range: 2001:db8:1:2:100::10-2001:db8:1:2:100:0:1:e
