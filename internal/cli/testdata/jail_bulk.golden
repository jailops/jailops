$ jailops create web --image freebsd-15@stable --network lan --storage default --label env=prod --start
jail/web created
jail/web started

$ jailops create db --image freebsd-15@stable --network lan --storage default --label env=prod --label tier=data
jail/db created

$ jailops create tmp --image freebsd-15@stable --network lan --storage default --label env=test
jail/tmp created

$ jailops list -c name,state
NAME   STATE
db     stopped
tmp    stopped
web    running

$ jailops stop -l env=prod
jail/db stopped
jail/web stopped

$ jailops start --all
jail/db started
jail/tmp started
jail/web started

$ jailops list --state running -o name
db
tmp
web

$ jailops stop web -l env=prod
! usage: name jails or select them with -l or --all, not both
! hint: run 'jailops stop --help' for usage
[exit 2]

$ jailops stop
! usage: name the jails, or select them with -l key=value or --all
! hint: run 'jailops stop --help' for usage
[exit 2]

$ jailops stop --all -l env=prod
! usage: use -l or --all, not both
! hint: run 'jailops stop --help' for usage
[exit 2]

$ jailops restart -l env=nothing
! No jails match.

$ jailops restart -l env=prod,tier=data --grace 1m30s
jail/db restarted

$ jailops restart db --grace soon
! usage: --grace must be a number of seconds or a duration such as 30s, not "soon"
! hint: run 'jailops restart --help' for usage
[exit 2]

$ jailops stop db --grace 5
jail/db stopped

$ jailops delete -l env=test
! conflict: jail "tmp" is running
! hint: stop it first ('jailops stop tmp'), or pass --force to stop it before the delete
[exit 5]

$ jailops stop tmp
jail/tmp stopped

$ jailops delete -l env=test
! This deletes 1 jail of project "main" and destroys its data; it cannot be undone:
!   tmp (stopped): root 256.0 MiB, data 70.0 MiB, 0 snapshots
! Type the name "main" to confirm: 
! usage: confirmation required: standard input is not a terminal and gave no answer
! hint: type the name on standard input, or pass --confirm-data-loss (-y does not answer this question)
[exit 2]

$ jailops delete -l env=test
! This deletes 1 jail of project "main" and destroys its data; it cannot be undone:
!   tmp (stopped): root 256.0 MiB, data 70.0 MiB, 0 snapshots
! Type the name "main" to confirm: aborted: the name did not match, nothing was changed
[exit 1]

$ jailops delete -l env=test -y
! This deletes 1 jail of project "main" and destroys its data; it cannot be undone:
!   tmp (stopped): root 256.0 MiB, data 70.0 MiB, 0 snapshots
! Type the name "main" to confirm: 
! usage: confirmation required: standard input is not a terminal and gave no answer
! hint: type the name on standard input, or pass --confirm-data-loss (-y does not answer this question)
[exit 2]

$ jailops delete -l env=test
jail/tmp deleted
! This deletes 1 jail of project "main" and destroys its data; it cannot be undone:
!   tmp (stopped): root 256.0 MiB, data 70.0 MiB, 0 snapshots
! Type the name "main" to confirm: 

$ jailops delete web
! conflict: jail "web" is running
! hint: stop it first ('jailops stop web'), or pass --force to stop it before the delete
[exit 5]

$ jailops --dry-run delete --force web
dry-run: would delete jail web (running): root 256.0 MiB, data 70.0 MiB, 0 snapshots; --force stops it first

$ jailops --dry-run delete --force web -o json
{
  "action": "delete jail",
  "destroys": [
    "web (running): root 256.0 MiB, data 70.0 MiB, 0 snapshots; --force stops it first"
  ],
  "dry_run": true
}

$ jailops --dry-run delete nosuch
! not_found: jail "nosuch" not found
! hint: list them with 'jailops jail list'; check --project, --host and --remote too
[exit 4]

$ jailops delete --force -y web
! This deletes 1 jail of project "main" and destroys its data; it cannot be undone:
!   web (running): root 256.0 MiB, data 70.0 MiB, 0 snapshots; --force stops it first
! Type the name "web" to confirm: 
! usage: confirmation required: standard input is not a terminal and gave no answer
! hint: type the name on standard input, or pass --confirm-data-loss (-y does not answer this question)
[exit 2]

$ jailops delete --force --confirm-data-loss web
jail/web stopped
jail/web deleted

$ jailops delete --all --force --confirm-data-loss
jail/db deleted

$ jailops list
