        "192.0.2.0/24"
      ],
      "host_port": 9090
    },
    {
      "proto": "udp",
      "ports": [
        "53"
      ],
      "families": [
        "6"
      ]
    },
    {
      "proto": "tcp",
      "ports": [
        "22"
      ]
    }
  ],
  "families": [
    {
      "family": "6",
      "address": "2001:db8::10",
      "network": "lan",
      "via": "uplink",
      "ports": "22"
    },
    {
      "family": "4",
      "address": "10.20.0.10",
      "network": "lan",
      "via": "forward",
      "ports": "22",
      "forwards": [
        "22->22"
      ]
    }
  ],
  "exposed": "22/tcp"
}

$ jailops expose web 80,443 --proto tcp,udp --family 6
jail/web exposed: 80,443/tcp,udp
  IPv6  2001:db8::10   open: no NAT, the jail's own address answers on 80, 443

$ jailops expose web 443 --from 192.0.2.0/24 --family 6
jail/web exposed: 443/tcp
  IPv6  2001:db8::10   open: no NAT, the jail's own address answers on 443

$ jailops expose web 5000 --proto tcp --proto udp --family 6
jail/web exposed: 5000/tcp,udp
  IPv6  2001:db8::10   open: no NAT, the jail's own address answers on 5000

$ jailops expose web 8000,8001 --host-port 9000
! invalid: --host-port takes one port: jailops expose web 8000 --host-port 9000, then jailops expose web 8001
[exit 2]

$ jailops expose web 8000-8100 --family 6
jail/web exposed: 8000-8100/tcp
  IPv6  2001:db8::10   open: no NAT, the jail's own address answers on 8000-8100

$ jailops unexpose web 8050
jail/web: nothing to remove
note: 8050 is inside the exposed range 8000-8100: unexpose the range to remove it
  still exposed: tcp 8080 (IPv4)
  still exposed: udp 53 (IPv6)
  still exposed: tcp 22 (IPv4 and IPv6)
  still exposed: tcp 80 (IPv6)
  still exposed: udp 80,443 (IPv6)
  still exposed: tcp 443 (IPv6)
  still exposed: tcp 5000 (IPv6)
  still exposed: udp 5000 (IPv6)
  still exposed: tcp 8000-8100 (IPv6)

$ jailops expose web 80 --proto sctp
! invalid: proto "sctp" must be tcp, udp or tcp,udp
[exit 2]

$ jailops expose ghost 80
! not_found: jail "ghost" not found
! hint: list them with 'jailops jail list'; check --project, --host and --remote too
[exit 4]

$ jailops expose web
! usage: accepts 2 arg(s), received 1
! hint: run 'jailops expose --help' for usage
[exit 2]

$ jailops unexpose web 80
jail/web: no longer exposed
  still exposed: tcp 8080 (IPv4)
  still exposed: udp 53 (IPv6)
  still exposed: tcp 22 (IPv4 and IPv6)
  still exposed: udp 443 (IPv6)
  still exposed: tcp 443 (IPv6)
  still exposed: tcp 5000 (IPv6)
  still exposed: udp 5000 (IPv6)
  still exposed: tcp 8000-8100 (IPv6)

$ jailops unexpose web --proto udp
jail/web: no longer exposed
  still exposed: tcp 8080 (IPv4)
  still exposed: tcp 22 (IPv4 and IPv6)
  still exposed: tcp 443 (IPv6)
  still exposed: tcp 5000 (IPv6)
  still exposed: tcp 8000-8100 (IPv6)

$ jailops unexpose web
jail/web: no longer exposed

$ jailops unexpose ghost
! not_found: jail "ghost" not found
! hint: list them with 'jailops jail list'; check --project, --host and --remote too
[exit 4]

