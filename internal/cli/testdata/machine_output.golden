$ jailops firewall show web -o yaml
project: main
jail: web
policies:
  - name: ssh
    source: jail
    rules: 1
    default_in: deny
rows:
  - source: internet
    family: 4,6
    proto: tcp,udp
    decision: none
    by: no allow in rule with an external source and no port forward
out:
  internet: all
  host: DNS and ping
  jails: all
  other_projects: none
default_in: deny
default_out: allow
default_in_by:
  - ssh
rules: []

