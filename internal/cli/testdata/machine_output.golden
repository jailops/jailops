name: web
project: main
uuid: <uuid>
hostname: web
power: running
jid: 1
os: freebsd
image: freebsd-15
generation: g1
storage: default
created_at: "2026-03-01T09:00:00Z"
started_at: "2026-03-01T09:00:00Z"
