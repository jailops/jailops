[exit 4]

$ jailops wireguard status office
PEER     ADDRESS        HANDSHAKE   RECEIVED / SENT     ENDPOINT
laptop   10.99.0.2/32   3h ago      1.0 MiB / 3.0 MiB   198.51.100.7:41000
phone    10.99.0.3/32   never       0 B / 0 B           -

$ jailops --dry-run wireguard join jwg1.
dry-run: would join a wireguard server
token: (token, not shown)

$ jailops wireguard join jwg1. --name home --endpoint 203.0.113.10:51820
wireguard/home joined

$ jailops wireguard join not-a-token
! invalid: not a WireGuard join token
! hint: copy the whole token that `jailops wireguard peer add` printed; it starts with jwg1.
[exit 2]

$ jailops wireguard list
NAME     MODE     INTERFACE   ADDRESS        PORT    ENDPOINT                PEERS   STATE   PUBLIC KEY
home     client   wg-home     10.99.0.2/32   -       203.0.113.10:51820      -       up      26hS8nHo4/g+r89O+hFa/j36dyxzPtGXfoXIHTav9Pg=
office   server   wg-office   10.99.0.1/24   51820   vpn.example.com:51820   2       up      t6mPQKDNW8r4zjBQwauu5y/FrT8fnESo1TguJKObezU=

$ jailops wireguard status home
PEER       ADDRESS        HANDSHAKE   RECEIVED / SENT     ENDPOINT
(server)   10.99.0.0/24   3h ago      4.0 KiB / 8.0 KiB   203.0.113.10:51820

$ jailops wireguard down home
wireguard/home is down

$ jailops wireguard up home
wireguard/home is up

$ jailops -y wireguard rotate-keys office
PUBLIC KEY
OAMuS96pCxbu52J/Cip4LvJDdT06Mz5xOzzXobqWml4=
! warning: every peer must be given the new public key: issue new tokens (jailops wireguard peer remove, then peer add)

$ jailops -y wireguard peer remove office laptop
peer/office/laptop removed

$ jailops wireguard peer list office -o name
phone

$ jailops -y wireguard delete home
wireguard/home deleted

$ jailops wireguard list -o name
office

