$ jailops wireguard create office --address 10.99.0.1/24 --network lan --endpoint vpn.example.com:51820
wireguard/office created

$ jailops wireguard create bad --mode client --address 10.98.0.2/32
! usage: a client is made from a join token: jailops wireguard join TOKEN
! hint: run 'jailops wireguard create --help' for usage
[exit 2]

$ jailops --dry-run wireguard peer add office laptop
dry-run: would enroll peer laptop of wireguard office
name: laptop

$ jailops wireguard peer add office laptop
jwg1.
! Peer laptop of wireguard office enrolled with 10.99.0.2/32.
! warning: this token holds the peer's private key and the preshared key: it is shown once, is not stored on this host, and gives whoever holds it access to the tunnel; pass it on over a channel you trust

$ jailops wireguard peer add office phone --format conf
