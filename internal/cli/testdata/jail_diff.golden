$ jailops jail create web --image freebsd-15@stable --storage default
jail/web created
! network lan: the only network of project main

$ jailops jail diff web
etc /etc: since the jail was made
  M /etc/rc.conf
local /usr/local: since the jail was made
  + /usr/local/etc/web.conf
total: 2 changes (1 added, 1 modified)

$ jailops jail diff web --summary
root       /           no changes
etc        /etc        1 change (1 modified)
local      /usr/local  1 change (1 added)
var-db     /var/db     no changes
var-log    /var/log    no changes
var-mail   /var/mail   no changes
var-spool  /var/spool  no changes
home       /home       no changes
rootdir    /root       no changes
total: 2 changes (1 added, 1 modified)

$ jailops jail diff web --dataset etc
etc /etc: since the jail was made
  M /etc/rc.conf
total: 1 change (1 modified)

$ jailops jail diff web --packages
etc /etc: since the jail was made
  M /etc/rc.conf
local /usr/local: since the jail was made
  + /usr/local/etc/web.conf
packages installed on purpose
  none
total: 2 changes (1 added, 1 modified)

