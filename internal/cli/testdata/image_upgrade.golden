$ jailops jail create web --image freebsd-15 --network lan --storage default
jail/web created

$ jailops image upgrade freebsd-15 --dry-run
dry-run: would build the next generation of freebsd-15 from freebsd-15#g1
  zfs clone tank/jailops/images/freebsd-15/g1@ro tank/jailops/images/freebsd-15/staging-g2
  pkg -r /jailops/images/freebsd-15/staging-g2 upgrade -y -r jailops

$ jailops image upgrade freebsd-15
generation/freebsd-15#g2 built from freebsd-15#g1

$ jailops image upgrade freebsd-15 -o json
{
  "from": "freebsd-15#g2",
  "generation": {
    "number": 3,
    "name": "freebsd-15#g3",
    "parent": 2,
    "manifest": "sha256:<hex>",
    "packages": 120,
    "dataset": "tank/jailops/images/freebsd-15/g3",
    "created_at": "2026-03-01T09:00:00Z"
  },
  "plan": [
    "zfs clone tank/jailops/images/freebsd-15/g2@ro tank/jailops/images/freebsd-15/staging-g3",
    "pkg -r /jailops/images/freebsd-15/staging-g3 upgrade -y -r jailops"
  ]
}

$ jailops image upgrade freebsd-15
image/freebsd-15 unchanged: freebsd-15#g3 already has the current package set; nothing to upgrade

$ jailops image upgrade freebsd-15 --to freebsd-15-1
