$ jailops list -o csv
NAME,STATE,OS,IMAGE,GEN,ADDRESSES,EXPOSED,AUTOSTART,USED,AGE
db,stopped,freebsd,freebsd-15,g1,"10.20.0.11,10.94.0.2,2001:db8:1:2:100::1",-,-,-,3h
web,running,freebsd,freebsd-15,g1,10.20.0.10,-,-,-,3h

$ jailops list -o csv --no-headers -c name,addresses
db,"10.20.0.11,10.94.0.2,2001:db8:1:2:100::1"
web,10.20.0.10

$ jailops network list -o csv
NAME,IPV4,GATEWAY,RANGE,USED,FREE,UPLINK
lan,10.20.0.0/24,10.20.0.1,10.20.0.10-10.20.0.20,2,9,em0
sw,10.94.0.0/24,10.94.0.1,10.94.0.2-10.94.0.254,2,251,em0

$ jailops jail show web -o csv
! usage: -o csv is not available for this command
