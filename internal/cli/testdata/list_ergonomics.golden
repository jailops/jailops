[exit 2]

$ jailops list --sort bogus
! usage: unknown column "bogus" (columns: name, state, os, image, gen, addresses, exposed, autostart, used, age, version, uptime, started, ipv4, ipv6)
! hint: run 'jailops list --help' for usage
[exit 2]

$ jailops list --state foo
! usage: unknown state "foo" (use stopped, starting, running, stopping, error, locked)
