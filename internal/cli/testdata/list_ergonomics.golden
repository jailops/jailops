$ jailops list w*
NAME   STATE     OS        IMAGE        GEN   ADDRESSES    EXPOSED   AUTOSTART   USED   AGE
web    running   freebsd   freebsd-15   g1    10.20.0.10   -         -           -      3h

$ jailops list nothing* d?
NAME   STATE     OS        IMAGE        GEN   ADDRESSES                                  EXPOSED   AUTOSTART   USED   AGE
db     stopped   freebsd   freebsd-15   g1    10.20.0.11,10.94.0.2,2001:db8:1:2:100::1   -         -           -      3h

$ jailops list [
! usage: bad name pattern "["
! hint: run 'jailops list --help' for usage
[exit 2]

$ jailops list -c name,state,age
NAME   STATE     AGE
db     stopped   3h
web    running   3h

$ jailops list --sort state
NAME   STATE     OS        IMAGE        GEN   ADDRESSES                                  EXPOSED   AUTOSTART   USED   AGE
web    running   freebsd   freebsd-15   g1    10.20.0.10                                 -         -           -      3h
db     stopped   freebsd   freebsd-15   g1    10.20.0.11,10.94.0.2,2001:db8:1:2:100::1   -         -           -      3h

$ jailops list --sort state -o name
web
db

$ jailops list -c name,bogus
