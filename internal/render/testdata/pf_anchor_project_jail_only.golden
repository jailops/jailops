# Managed by JailOps. Do not edit; changes are overwritten.
# anchor jailops/web/nginx
# tags: tier-1 web
table <s_office> persist { 198.51.100.7, 2001:db8:ffff::/48, 203.0.113.0/24 }
# the host's own addresses (a jail reaches none of them unless a rule says so)
table <host> persist
# what an allow rule to any does not reach: the host and the networks of other projects (name them to open them)
table <not_any> persist
table <t_admin> persist { 10.20.0.4, 10.20.0.5 }
# rdr rule 5: forward
match in on em0 inet proto tcp from any to (em0) port 8080 rdr-to 10.20.0.10 port 80
pass in quick on em0 inet proto tcp from any to 10.20.0.10 port 80 label "jo-7e7ce9c63e11" keep state (if-bound)
match in on em0 inet6 proto tcp from any to (em0) port 8080 rdr-to 2001:db8:1::100 port 80
pass in quick on em0 inet6 proto tcp from any to 2001:db8:1::100 port 80 label "jo-030a87ad37c5" keep state (if-bound)
table <jail_addrs> persist { 10.20.0.10, 2001:db8:1::100, fe80::/10 }
block in quick on jo0123456789a0a inet6 proto icmp6 from any to any icmp6-type { routeradv, redir }
pass in quick on jo0123456789a0a inet6 proto icmp6 from :: to ff02::1:ff00:0/104 icmp6-type neighbrsol label "jo-95b1d29be2ed" keep state (if-bound)
block in quick on jo0123456789a0a from ! <jail_addrs> to any
block in quick on jo0123456789a0a inet6 proto icmp6 from any to ff02::/16 icmp6-type neighbradv
pass in quick on jo0123456789a0a inet6 proto icmp6 from { 2001:db8:1::100, fe80::/10 } to any icmp6-type { neighbrsol, neighbradv } label "jo-fbeca53a6fa2" keep state (if-bound)
pass in quick on jo0123456789a0a inet6 proto icmp6 from { 2001:db8:1::100, fe80::/10 } to ff02::/16 icmp6-type { listenrep, listendone, 143 } label "jo-d5eff27eb55d" keep state (if-bound)
pass in quick on jo0123456789a0a inet6 proto icmp6 from { 2001:db8:1::100, fe80::/10 } to any icmp6-type { unreach, toobig, timex, paramprob } label "jo-76c6683ca544" keep state (if-bound)
block out quick on jo0123456789a0a inet6 proto icmp6 from any to any icmp6-type { redir, routeradv }
pass out quick on jo0123456789a0a inet6 proto icmp6 from any to { 2001:db8:1::100, fe80::/10, ff02::1:ff00:0/104 } icmp6-type { neighbrsol, neighbradv } label "jo-35269114a6fb" keep state (if-bound)
pass out quick on jo0123456789a0a inet6 proto icmp6 from any to any icmp6-type { unreach, toobig, timex, paramprob } label "jo-af79760001df" keep state (if-bound)
block drop out quick on jo0123456789a0a from any to ! <jail_addrs>
block drop out quick on jo0123456789a0a inet proto icmp from any to any icmp-type redir
# deny rules of all policies: they win over every allow rule, whatever the order of the policies
# policy web
# rule 6: no smtp
block drop in quick on jo0123456789a0a inet proto tcp from 10.20.0.10 to any port 25
block drop in quick on jo0123456789a0a inet6 proto tcp from 2001:db8:1::100 to any port 25
# the host: closed to the jail whatever its policies allow; ping, the errors a path needs and the network's resolver stay open
pass in quick on jo0123456789a0a inet proto icmp from any to <host> icmp-type { echoreq, unreach, timex, paramprob } label "jo-a848aec44484" keep state (if-bound)
pass in quick on jo0123456789a0a inet6 proto icmp6 from any to <host> icmp6-type { echoreq, unreach, toobig, timex, paramprob } label "jo-e3483483cfb5" keep state (if-bound)
block drop in quick on jo0123456789a0a from any to <host>
# allow rules of the policies, in the order of the policies
# policy web
# rule 1: ssh from office
pass out log quick on jo0123456789a0a inet proto tcp from { <s_office>, <t_admin> } to 10.20.0.10 port 22 label "jo-b3144fb2e58f" keep state (if-bound)
pass out log quick on jo0123456789a0a inet6 proto tcp from { <s_office>, <t_admin> } to 2001:db8:1::100 port 22 label "jo-43e48b5dbd12" keep state (if-bound)
# rule 2: web
pass out quick on jo0123456789a0a inet proto tcp from any to 10.20.0.10 port { 80, 8000:8100 } label "jo-8d44ec0c00ee" keep state (if-bound)
pass out quick on jo0123456789a0a inet6 proto tcp from any to 2001:db8:1::100 port { 80, 8000:8100 } label "jo-0bb711e77957" keep state (if-bound)
# rule 3: ping
pass out quick on jo0123456789a0a inet proto icmp from any to 10.20.0.10 label "jo-3c9c9479a5eb" keep state (if-bound)
# rule 4: ping6
pass out quick on jo0123456789a0a inet6 proto icmp6 from any to 2001:db8:1::100 label "jo-b420deef236d" keep state (if-bound)
# rule 5: forward
pass out quick on jo0123456789a0a inet proto tcp from any to 10.20.0.10 port 80 label "jo-b2a787550852" keep state (if-bound)
pass out quick on jo0123456789a0a inet6 proto tcp from any to 2001:db8:1::100 port 80 label "jo-2beae49e1e41" keep state (if-bound)
