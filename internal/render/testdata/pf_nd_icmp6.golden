# Managed by JailOps. Do not edit; changes are overwritten.
# anchor jailops/alpha/web
# the host's own addresses (a jail reaches none of them unless a rule says so)
table <host> persist { }
table <jail_addrs> persist { 10.20.0.10, 2001:db8:1::100, fe80::2858:8aff:fe88:fcd2 }
block in quick on joe1a inet6 proto icmp6 from any to any icmp6-type { routeradv, redir }
pass in quick on joe1a inet6 proto icmp6 from :: to ff02::1:ff00:0/104 icmp6-type neighbrsol label "jo-f5191988cb09" keep state (if-bound)
block in quick on joe1a from ! <jail_addrs> to any
block in quick on joe1a inet6 proto icmp6 from any to ff02::/16 icmp6-type neighbradv
pass in quick on joe1a inet6 proto icmp6 from { 2001:db8:1::100, fe80::2858:8aff:fe88:fcd2 } to { fe80::/10, ff02::1:ff00:0/104 } icmp6-type { neighbrsol, neighbradv } label "jo-9c66c1239888" keep state (if-bound)
pass in quick on joe1a inet6 proto icmp6 from { 2001:db8:1::100, fe80::2858:8aff:fe88:fcd2 } to ff02::/16 icmp6-type { listenrep, listendone, 143 } label "jo-bffb4b751623" keep state (if-bound)
block out quick on joe1a inet6 proto icmp6 from any to any icmp6-type { redir, routeradv }
pass out quick on joe1a inet6 proto icmp6 from any to { 2001:db8:1::100, fe80::2858:8aff:fe88:fcd2, ff02::1:ff00:100, ff02::1:ff88:fcd2 } icmp6-type { neighbrsol, neighbradv } label "jo-ba419d70d8d7" keep state (if-bound)
pass out quick on joe1a inet6 proto icmp6 from any to any icmp6-type { unreach, toobig, timex, paramprob } label "jo-81d042bbf431" keep state (if-bound)
block drop out quick on joe1a from any to ! <jail_addrs>
block drop out quick on joe1a inet proto icmp from any to any icmp-type redir
block drop in quick on joe1a inet from any to 255.255.255.255
# the host: closed to the jail whatever its policies allow; ping, the errors a path needs and the network's resolver stay open
pass in quick on joe1a inet proto icmp from any to <host> icmp-type { echoreq, unreach, timex, paramprob } label "jo-d8412908eaac" keep state (if-bound)
pass in quick on joe1a inet6 proto icmp6 from any to <host> icmp6-type { echoreq, unreach, toobig, timex, paramprob } label "jo-0c7c27adc024" keep state (if-bound)
block drop in quick on joe1a from any to <host>
# policy web
# defaults: final (quick), so that no rule of the host's own pf.conf after the anchor line changes them
block drop out quick on joe1a all
block drop in quick on joe1a all
