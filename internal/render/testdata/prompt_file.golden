# Managed by JailOps: the prompt of this jail. JailOps rewrites this file;
# change the prompt with: jailops config set JAIL prompt default|short|none|PS1
# In bash your own ~/.bashrc or ~/.bash_profile is read after this file and wins; in sh this file is read at
# the end of ~/.shrc, after ~/.profile: set a PS1 of your own below the JailOps block of ~/.shrc.
# Only an interactive shell (sh or bash) sets the prompt; scripts, sh -c and bash -c are not affected.
case "$-" in
*i*)
	_jailops_where="${JAILOPS_PROJECT-}${JAILOPS_PROJECT:+${JAILOPS_HOST:+/}}${JAILOPS_HOST-}"
	PS1='\[\e[38;5;39m\]\u@\h\[\e[0m\]${_jailops_where:+ \[\e[38;5;245m\][${_jailops_where}]\[\e[0m\]}:\w\$ '
	;;
esac
