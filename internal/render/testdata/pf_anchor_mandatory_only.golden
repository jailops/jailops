# deny rules of all policies: they win over every allow rule, whatever the order of the policies
# project policy baseline
# rule 1: no telnet
block drop out quick on jo0123456789a0a inet proto tcp from any to 10.20.0.10 port 23
block drop out quick on jo0123456789a0a inet6 proto tcp from any to 2001:db8:1::100 port 23
# rule 2: no smtp
block drop in quick on jo0123456789a0a inet proto tcp from 10.20.0.10 to any port 25
block drop in quick on jo0123456789a0a inet6 proto tcp from 2001:db8:1::100 to any port 25
# the host: closed to the jail whatever its policies allow; ping, the errors a path needs and the network's resolver stay open
pass in quick on jo0123456789a0a inet proto icmp from any to <host> icmp-type { echoreq, unreach, timex, paramprob } label "jo-0dcd40fe636f" keep state (if-bound)
pass in quick on jo0123456789a0a inet6 proto icmp6 from any to <host> icmp6-type { echoreq, unreach, toobig, timex, paramprob } label "jo-035bf6045ea2" keep state (if-bound)
block drop in quick on jo0123456789a0a from any to <host>
# allow rules of the policies, in the order of the policies
# project policy baseline
# rule 3: mgmt
pass out quick on jo0123456789a0a inet proto tcp from <s_office> to 10.20.0.10 port 22 label "jo-f98df7e71cb9" keep state (if-bound)
pass out quick on jo0123456789a0a inet6 proto tcp from <s_office> to 2001:db8:1::100 port 22 label "jo-76de73c4d942" keep state (if-bound)
# rule 4: fwd
pass out quick on jo0123456789a0a inet proto tcp from any to 10.20.0.10 port 22 label "jo-e806ef398bb9" keep state (if-bound)
pass out quick on jo0123456789a0a inet6 proto tcp from any to 2001:db8:1::100 port 22 label "jo-267d7bbd8809" keep state (if-bound)
# defaults: final (quick), so that no rule of the host's own pf.conf after the anchor line changes them
block drop out quick on jo0123456789a0a all
pass in quick on jo0123456789a0a all label "jo-8fab40e9915d" keep state (if-bound)
