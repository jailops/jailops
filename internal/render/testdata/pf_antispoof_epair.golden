# Managed by JailOps. Do not edit; changes are overwritten.
# anchor jailops/alpha/web
# the host's own addresses (a jail reaches none of them unless a rule says so)
table <host> persist
# what an allow rule to any does not reach: the host and the networks of other projects (name them to open them)
table <not_any> persist
table <jail_addrs> persist { 10.20.0.10, fd00::10, fe80::/10 }
block in quick on { joe1a, joe2a } inet6 proto icmp6 from any to any icmp6-type { routeradv, redir }
pass in quick on { joe1a, joe2a } inet6 proto icmp6 from :: to ff02::1:ff00:0/104 icmp6-type neighbrsol label "jo-b70cd41fff32" keep state (if-bound)
block in quick on { joe1a, joe2a } from ! <jail_addrs> to any
block in quick on { joe1a, joe2a } inet6 proto icmp6 from any to ff02::/16 icmp6-type neighbradv
pass in quick on { joe1a, joe2a } inet6 proto icmp6 from { fd00::10, fe80::/10 } to any icmp6-type { neighbrsol, neighbradv } label "jo-d38a5e5c491b" keep state (if-bound)
pass in quick on { joe1a, joe2a } inet6 proto icmp6 from { fd00::10, fe80::/10 } to ff02::/16 icmp6-type { listenrep, listendone, 143 } label "jo-f4ede021d406" keep state (if-bound)
pass in quick on { joe1a, joe2a } inet6 proto icmp6 from { fd00::10, fe80::/10 } to any icmp6-type { unreach, toobig, timex, paramprob } label "jo-57f8e328cd2f" keep state (if-bound)
block out quick on { joe1a, joe2a } inet6 proto icmp6 from any to any icmp6-type { redir, routeradv }
pass out quick on { joe1a, joe2a } inet6 proto icmp6 from any to { fd00::10, fe80::/10, ff02::1:ff00:0/104 } icmp6-type { neighbrsol, neighbradv } label "jo-433a2021e04c" keep state (if-bound)
pass out quick on { joe1a, joe2a } inet6 proto icmp6 from any to any icmp6-type { unreach, toobig, timex, paramprob } label "jo-cfe0a26510b5" keep state (if-bound)
block drop out quick on { joe1a, joe2a } from any to ! <jail_addrs>
block drop out quick on { joe1a, joe2a } inet proto icmp from any to any icmp-type redir
# the host: closed to the jail whatever its policies allow; ping, the errors a path needs and the network's resolver stay open
pass in quick on { joe1a, joe2a } inet proto icmp from any to <host> icmp-type { echoreq, unreach, timex, paramprob } label "jo-bc500948aa73" keep state (if-bound)
pass in quick on { joe1a, joe2a } inet6 proto icmp6 from any to <host> icmp6-type { echoreq, unreach, toobig, timex, paramprob } label "jo-f6af59e4abec" keep state (if-bound)
block drop in quick on { joe1a, joe2a } from any to <host>
# policy web
# defaults: final (quick), so that no rule of the host's own pf.conf after the anchor line changes them
block drop out quick on { joe1a, joe2a } all
pass in quick on { joe1a, joe2a } all label "jo-5fd76a81e5a0" keep state (if-bound)
