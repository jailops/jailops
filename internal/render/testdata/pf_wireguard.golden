# Managed by JailOps. Do not edit; changes are overwritten.
# anchor jailops/wg.office: what protects the host from the tunnel; what the peers reach in a jail is decided by the jail's own allow in rules
table <host> persist { 10.20.0.1, 10.99.0.1, 203.0.113.2 }
table <tunnel_nets> persist { 10.99.0.0/24, fd99::/64 }
# a packet that comes in on the tunnel with a source that is no address of the tunnel is forged
block drop in quick on wg-office from ! <tunnel_nets> to any
# the host: closed to the peers (the host's own pf.conf decides what the host offers them, if anything)
block drop in quick on wg-office from any to <host>
table <served_nets> persist { 10.20.0.0/24, 2001:db8:1:2:100::/80 }
# a peer reaches the networks this tunnel serves (their jails decide) and nothing else
block drop in quick on wg-office from any to ! <served_nets>
