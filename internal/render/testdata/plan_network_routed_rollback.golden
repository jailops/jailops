10 ifconfig jo0ga mtu 1500
11 ifconfig jo0 mtu 1500
12 ifconfig jo0gb -description
13 ifconfig jo0ga -description
14 ifconfig jo0ga destroy
15 ifconfig jo0 -description
16 ifconfig jo0 destroy
