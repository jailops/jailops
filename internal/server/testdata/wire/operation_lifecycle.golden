}

# busy: another change of the locked jail is refused with 409 and the code busy, a read is not
> PUT /api/v1/jails/web/state?project=alpha
> {"action":"start"}
< 409 Conflict
< Content-Type: application/json
< Cache-Control: no-store
{
  "error": {
    "code": "busy",
    "detail": {
      "resource": "jail/alpha_web"
    },
    "hint": "wait for the other operation to finish",
    "message": "jail/alpha_web is busy: Snapshot jail web is running"
  },
  "status": "Failure",
  "status_code": 409,
  "type": "error"
}

