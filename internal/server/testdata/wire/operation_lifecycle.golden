# cancelling a finished operation is refused with 400 invalid
> DELETE /api/v1/operations/<op2>?project=alpha
< 400 Bad Request
< Content-Type: application/json
< Cache-Control: no-store
{
  "error": {
    "code": "invalid",
    "message": "operation \"<uuid>\" is already finished and cannot be cancelled"
  },
  "status": "Failure",
  "status_code": 400,
  "type": "error"
}

# the lock is gone: the same request succeeds now, and nothing of the cancelled one is left
> GET /api/v1/jails/web/snapshots?project=alpha
< 200 OK
< Content-Type: application/json
< Cache-Control: no-store
{
  "metadata": [],
  "status": "Success",
  "status_code": 200,
  "type": "sync"
}

# failure: the operation ends as failure; its error has the code and the message a synchronous request would have answered
