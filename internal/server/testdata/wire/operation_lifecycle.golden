}

# running: the record says so and says it may be cancelled
> GET /api/v1/operations/<op2>?project=alpha
< 200 OK
< Content-Type: application/json
< Cache-Control: no-store
{
  "metadata": {
    "action": "jail.snapshot",
    "created_at": "<time>",
    "description": "Snapshot jail web",
    "id": "<op2>",
    "may_cancel": true,
    "project": "alpha",
    "resources": {
      "jails": [
        "/api/v1/jails/web"
      ]
    },
    "status": "running",
    "updated_at": "<time>"
  },
  "status": "Success",
  "status_code": 200,
  "type": "sync"
}

# a wait that ends before the operation does answers with the running record
