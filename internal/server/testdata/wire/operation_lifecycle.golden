  "metadata": {
    "action": "jail.create",
    "created_at": "<time>",
    "description": "Create jail web",
    "id": "<op1>",
    "may_cancel": "<volatile>",
    "project": "alpha",
    "resources": {
      "jails": [
        "/api/v1/jails/web"
      ]
    },
    "status": "<volatile>",
    "updated_at": "<volatile>"
  },
  "operation": "/api/v1/operations/<op1>",
  "status": "Operation created",
  "status_code": 202,
  "type": "async"
}

