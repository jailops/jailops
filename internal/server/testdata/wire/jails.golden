# errors: not found, an invalid name, an unknown route
> GET /api/v1/jails/nope?project=alpha
< 404 Not Found
< Content-Type: application/json
< Cache-Control: no-store
{
  "error": {
    "code": "not_found",
    "message": "jail \"nope\" not found"
  },
  "status": "Failure",
  "status_code": 404,
  "type": "error"
}

> POST /api/v1/jails?project=alpha
> {"metadata":{"name":"Bad_Name"},"spec":{"image":"fb"}}
< 400 Bad Request
< Content-Type: application/json
< Cache-Control: no-store
{
  "error": {
    "code": "invalid",
    "detail": {
      "field": "name"
    },
    "message": "name \"Bad_Name\" must be lower case letters, digits and hyphens, start with a letter, not end in a hyphen, at most 63 characters"
  },
  "status": "Failure",
  "status_code": 400,
  "type": "error"
}

> GET /api/v1/nothing?project=alpha
< 404 Not Found
< Content-Type: application/json
< Cache-Control: no-store
{
  "error": {
    "code": "not_found",
    "message": "no such route GET /api/v1/nothing"
  },
  "status": "Failure",
  "status_code": 404,
  "type": "error"
}

