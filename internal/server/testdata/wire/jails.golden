# create: the request is accepted with 202 and the Location of the operation; the operation ends with the jail
> POST /api/v1/jails?project=alpha
> {"metadata":{"name":"web"},"spec":{"image":"fb","storage":"default","update":{"healthcheck":"/bin/true"},"network":[{"network":"lan","ipv4":"auto"}]}}
< 202 Accepted
< Content-Type: application/json
< Cache-Control: no-store
< Location: /api/v1/operations/<op1>
{
  "metadata": {
    "action": "jail.create",
    "created_at": "<time>",
    "description": "Create jail web",
    "id": "<op1>",
    "may_cancel": "<volatile>",
    "project": "alpha",
    "resources": {
      "jails": [
        "/api/v1/jails/web"
      ]
    },
    "status": "<volatile>",
    "updated_at": "<volatile>"
  },
  "operation": "/api/v1/operations/<op1>",
  "status": "Operation created",
  "status_code": 202,
  "type": "async"
}

> GET /api/v1/operations/<op1>/wait?project=alpha&timeout=5
< 200 OK
< Content-Type: application/json
< Cache-Control: no-store
{
  "metadata": {
    "action": "jail.create",
    "created_at": "<time>",
    "description": "Create jail web",
    "id": "<op1>",
    "may_cancel": false,
    "metadata": {
      "metadata": {
        "created_at": "<time>",
        "generation": 1,
        "host": "<uuid>",
        "name": "web",
        "project": "alpha",
        "scope": "host",
        "updated_at": "<time>",
        "uuid": "<uuid>"
      },
      "spec": {
        "boot": {},
        "firewall": {},
        "hostname": "web",
        "image": "fb",
        "network": [
          {
            "ipv4": "10.20.0.10",
            "name": "eth0",
            "network": "lan"
          }
        ],
        "os": "freebsd",
        "prompt": "default",
        "resources": {},
        "shell": "/usr/local/bin/bash",
        "storage": "default",
        "update": {
          "healthcheck": "/bin/true"
        }
      },
      "status": {
        "freebsd_version": "15.1-RELEASE-p1",
        "image_generation": "fb#g1",
        "power": "stopped"
      }
    },
    "progress": 100,
    "project": "alpha",
    "resources": {
      "jails": [
        "/api/v1/jails/web"
      ]
    },
    "status": "success",
    "steps": [
      {
        "duration_ms": "<ms>",
        "name": "<step>"
      }
    ],
    "updated_at": "<time>"
  },
  "status": "Success",
  "status_code": 200,
  "type": "sync"
}

# read: the ETag is the generation, the object carries metadata, spec and status
> GET /api/v1/jails/web?project=alpha
< 200 OK
< Content-Type: application/json
< Cache-Control: no-store
< ETag: "<uuid>-1"
{
  "metadata": {
    "metadata": {
      "created_at": "<time>",
      "generation": 1,
      "host": "<uuid>",
      "name": "web",
      "project": "alpha",
      "scope": "host",
      "updated_at": "<time>",
      "uuid": "<uuid>"
    },
    "spec": {
      "boot": {},
      "firewall": {},
      "hostname": "web",
      "image": "fb",
      "network": [
        {
          "ipv4": "10.20.0.10",
          "name": "eth0",
          "network": "lan"
        }
      ],
      "os": "freebsd",
      "prompt": "default",
      "resources": {},
      "shell": "/usr/local/bin/bash",
      "storage": "default",
      "update": {
        "healthcheck": "/bin/true"
      }
    },
    "status": {
      "freebsd_version": "15.1-RELEASE-p1",
      "image_generation": "fb#g1",
      "power": "stopped"
    }
  },
  "status": "Success",
  "status_code": 200,
  "type": "sync"
}

