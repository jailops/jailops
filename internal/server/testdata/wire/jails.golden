# a merge patch with the current tag succeeds and answers the new tag
> PATCH /api/v1/jails/web?project=alpha
> If-Match: "<uuid>-1"
> {"spec":{"comment":"the site"}}
< 200 OK
< Content-Type: application/json
< Cache-Control: no-store
< ETag: "<uuid>-2"
{
  "metadata": {
    "metadata": {
      "created_at": "<time>",
      "generation": 2,
      "host": "<uuid>",
      "name": "web",
      "project": "alpha",
      "scope": "host",
      "updated_at": "<time>",
      "uuid": "<uuid>"
    },
    "spec": {
      "boot": {},
      "comment": "the site",
      "firewall": {},
      "hostname": "web",
      "image": "fb",
      "network": [
        {
          "ipv4": "10.20.0.10",
          "name": "eth0",
          "network": "lan"
        }
      ],
      "os": "freebsd",
      "prompt": "default",
      "resources": {},
      "shell": "/usr/local/bin/bash",
      "storage": "default",
      "update": {
        "healthcheck": "/bin/true"
      }
    },
    "status": {
      "freebsd_version": "15.1-RELEASE-p1",
      "image_generation": "fb#g1",
      "power": "stopped"
    }
  },
  "status": "Success",
  "status_code": 200,
  "type": "sync"
}

# the same tag again is stale: 412 conflict
> PATCH /api/v1/jails/web?project=alpha
> If-Match: "<uuid>-1"
> {"spec":{"comment":"other"}}
< 412 Precondition Failed
< Content-Type: application/json
< Cache-Control: no-store
{
  "error": {
    "code": "precondition_failed",
    "message": "jail \"web\" changed: current generation is 2"
  },
  "status": "Failure",
  "status_code": 412,
  "type": "error"
}

# a member the type does not have is invalid, and the message names it
> PATCH /api/v1/jails/web?project=alpha
> {"spec":{"coment":"typo"}}
< 400 Bad Request
< Content-Type: application/json
< Cache-Control: no-store
{
  "error": {
    "code": "invalid",
    "message": "invalid request body: unknown member \"spec.coment\""
  },
  "status": "Failure",
  "status_code": 400,
  "type": "error"
}

# the state: start is asynchronous, the state is read from its own route
> PUT /api/v1/jails/web/state?project=alpha
> {"action":"start"}
