    "description": "Create jail web",
    "id": "<op1>",
    "may_cancel": false,
    "metadata": {
      "metadata": {
        "created_at": "<time>",
        "generation": 1,
        "host": "<uuid>",
        "name": "web",
        "project": "alpha",
        "scope": "host",
        "updated_at": "<time>",
        "uuid": "<uuid>"
      },
      "spec": {
        "boot": {},
        "firewall": {},
        "hostname": "web",
        "image": "fb",
        "layout": "thin",
        "network": [
          {
            "ipv4": "10.20.0.10",
            "name": "eth0",
            "network": "lan"
          }
        ],
        "os": "freebsd",
        "prompt": "default",
        "resources": {},
        "shell": "/usr/local/bin/bash",
        "storage": "default",
        "update": {
          "healthcheck": "/bin/true"
        }
      },
      "status": {
        "freebsd_version": "15.1-RELEASE-p1",
        "image_generation": "fb#g1",
        "power": "stopped"
      }
