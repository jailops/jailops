    "progress": 100,
    "project": "alpha",
    "resources": {
      "jails": [
        "/api/v1/jails/web"
      ]
    },
    "status": "success",
    "steps": [
      {
        "duration_ms": "<ms>",
        "name": "<step>"
      }
    ],
    "updated_at": "<time>"
  },
  "status": "Success",
  "status_code": 200,
  "type": "sync"
}

