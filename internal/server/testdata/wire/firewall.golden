      "host": "nothing (the host is closed to jails (DNS and ping to the gateway excepted))",
      "internet": "tcp all ports, udp all ports",
      "jails": "tcp all ports, udp all ports",
      "other_projects": "nothing"
    },
    "policies": [
      {
        "name": "ssh",
        "rules": 1,
        "source": "jail"
      }
    ],
    "project": "alpha",
    "rows": [
      {
        "by": "the inbound default is allow (no policy says deny)",
        "decision": "pass",
        "family": "4",
        "ports": "all",
        "proto": "tcp",
        "source": "jails",
        "stage": "default"
      },
      {
        "by": "the inbound default is allow (no policy says deny)",
        "decision": "pass",
        "family": "4",
        "ports": "all",
        "proto": "udp",
        "source": "jails",
        "stage": "default"
      },
      {
        "by": "the inbound default is allow (no policy says deny)",
        "decision": "pass",
        "family": "4",
        "ports": "all",
        "proto": "tcp",
        "source": "host",
        "stage": "default"
      },
      {
        "by": "the inbound default is allow (no policy says deny)",
        "decision": "pass",
        "family": "4",
        "ports": "all",
        "proto": "udp",
        "source": "host",
        "stage": "default"
      },
      {
        "by": "nothing of this anchor decides",
        "decision": "none",
        "family": "4,6",
        "proto": "tcp,udp",
        "source": "other-projects"
      }
    ],
    "rules": [
      {
        "by": "protection: only the jail's own source addresses",
        "decision": "block",
        "direction": "from",
        "family": "4,6",
        "from": "not jail_addrs",
        "pf": "block in quick on <link> from ! <jail_addrs> to any",
        "stage": "antispoof",
        "to": "any",
        "where": "link"
      },
      {
        "by": "protection: only the jail's own addresses reach it",
        "decision": "block",
        "direction": "to",
        "family": "4,6",
        "from": "any",
        "pf": "block drop out quick on <link> from any to ! <jail_addrs>",
        "stage": "own-addresses",
        "to": "not jail_addrs",
        "where": "link"
      },
      {
        "by": "protection: only the jail's own addresses reach it",
        "decision": "block",
        "direction": "to",
        "family": "4",
        "from": "any",
        "pf": "block drop out quick on <link> inet proto icmp from any to any icmp-type redir",
        "proto": "icmp",
        "stage": "own-addresses",
        "to": "any",
        "where": "link"
      },
      {
        "by": "the host is closed to jails (DNS and ping to the gateway excepted)",
        "decision": "pass",
        "direction": "from",
        "family": "4",
        "from": "any",
        "pf": "pass in quick on <link> inet proto icmp from any to <host> icmp-type { echoreq, unreach, timex, paramprob } label \"jo-<label>\" keep state (max 10000, if-bound)",
        "proto": "icmp",
        "stage": "host",
        "to": "host",
        "where": "link"
      },
      {
        "by": "the host is closed to jails (DNS and ping to the gateway excepted)",
        "decision": "block",
        "direction": "from",
        "family": "4,6",
        "from": "any",
        "pf": "block drop in quick on <link> from any to <host>",
        "stage": "host",
        "to": "host",
        "where": "link"
      },
      {
        "by": "policy ssh rule 1",
        "decision": "pass",
        "direction": "to",
        "family": "4",
        "from": "set:office",
        "pf": "pass out quick on <link> inet proto tcp from <s_office> to 10.20.0.10 port 22 label \"jo-<label>\" keep state (max 10000, if-bound)",
        "ports": "22",
        "proto": "tcp",
        "stage": "policy",
        "to": "10.20.0.10/32",
        "where": "link"
      },
