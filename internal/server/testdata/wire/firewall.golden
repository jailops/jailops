> POST /api/v1/firewall/test?project=alpha
> {"from":"192.0.2.7","to":"jail:web","proto":"tcp","port":22}
< 200 OK
< Content-Type: application/json
< Cache-Control: no-store
{
  "metadata": {
    "cases": [
      {
        "family": "inet",
        "from": "192.0.2.7",
        "hops": [
          {
            "anchor": "jailops/alpha/web",
            "decided_by": {
              "pf": "pass out quick on <link> inet proto tcp from <s_office> to 10.20.0.10 port 22 label \"jo-<label>\" keep state (max 10000, if-bound)",
              "policy": "ssh",
              "rule": 1,
              "stage": "policy"
            },
            "direction": "out",
            "jail": "web",
            "loaded_matches_rendered": "false",
            "side": "destination",
            "verdict": "pass"
          }
        ],
        "port": 22,
        "proto": "tcp",
        "to": "10.20.0.10",
        "verdict": "pass"
      }
    ],
    "caveats": [
      "the answer is for a new connection: a connection that is already open (pf keeps its state) is not asked about",
      "only JailOps' rules are evaluated: a rule of an anchor that passes or blocks is final, so /etc/pf.conf after the anchor line never sees the packet; quick rules of pf.conf before the anchor line are not evaluated (jailops doctor: pf.inbound and pf.order name such rules)",
      "on the way out of the host only the destination jail's anchor is evaluated, not the anchors of other jails"
    ],
    "verdict": "pass"
  },
  "status": "Success",
  "status_code": 200,
  "type": "sync"
}

# a policy in use is not deleted
> DELETE /api/v1/firewall/policies/ssh?project=alpha
< 409 Conflict
< Content-Type: application/json
< Cache-Control: no-store
{
  "error": {
    "code": "busy",
    "message": "firewall policy \"ssh\" is used by jail \"web\""
  },
  "status": "Failure",
  "status_code": 409,
  "type": "error"
}

