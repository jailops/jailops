# without a credential, and with a name that does not exist
> GET /api/v1/jails?project=alpha
< 401 Unauthorized
< Content-Type: application/json
< Cache-Control: no-store
{
  "error": {
    "code": "unauthorized",
    "message": "unsupported authorization scheme"
  },
  "status": "Failure",
  "status_code": 401,
  "type": "error"
}

> GET /api/v1/projects/nope
< 404 Not Found
< Content-Type: application/json
< Cache-Control: no-store
{
  "error": {
    "code": "not_found",
    "message": "project \"nope\" not found"
  },
  "status": "Failure",
  "status_code": 404,
  "type": "error"
}

