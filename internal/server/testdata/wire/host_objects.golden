# projects: read, create (synchronous, 201), change with If-Match, delete
> GET /api/v1/projects
< 200 OK
< Content-Type: application/json
< Cache-Control: no-store
{
  "metadata": [
    {
      "metadata": {
        "created_at": "<time>",
        "generation": 1,
        "host": "<uuid>",
        "name": "alpha",
        "scope": "host",
        "updated_at": "<time>",
        "uuid": "<uuid>"
      },
      "spec": {
        "networks": [
          {
            "network": "lan"
          }
        ],
        "quotas": {},
        "storage": [
          {
            "storage": "default"
          }
        ]
      },
