# the server info with an identity
> GET /api/v1?project=alpha
< 200 OK
< Content-Type: application/json
< Cache-Control: no-store
{
  "metadata": {
    "api_extensions": "<the list of extensions.golden>",
    "api_version": "1.0",
    "auth": "trusted",
    "environment": {
      "arch": "amd64",
      "kernel_version": "15.1-RELEASE-p1",
      "os": "FreeBSD",
      "pf": true,
      "pool": "tank"
    },
    "host_uuid": "<uuid>",
    "hostname": "testhost",
    "role": "host",
    "secrets_recipient": "<age-recipient>",
    "version": "test"
  },
  "status": "Success",
  "status_code": 200,
  "type": "sync"
}

# networks, storage and images are host objects: no project in the request
> GET /api/v1/networks
< 200 OK
< Content-Type: application/json
< Cache-Control: no-store
{
  "metadata": [
    {
      "metadata": {
        "created_at": "<time>",
        "generation": 1,
        "name": "lan",
        "scope": "fleet",
        "updated_at": "<time>",
        "uuid": "<uuid>"
      },
      "spec": {
        "ipv4": {
          "gateway": "10.20.0.1",
          "range": "10.20.0.10-10.20.0.50",
          "subnet": "10.20.0.0/24"
        }
      },
      "status": {
        "dns": {
          "nameservers": [
            "198.51.100.1"
          ],
          "source": "host"
        },
        "free": 41,
        "granted_to": [
          "alpha"
        ]
      }
    }
  ],
  "status": "Success",
  "status_code": 200,
  "type": "sync"
}

