#!/bin/sh
#
# PROVIDE: jailopsd
# REQUIRE: jailops_priv NETWORKING pf syslogd
# KEYWORD: shutdown
#
# "pf" is required even when pf_enable is NO (rcorder only orders the scripts; a disabled service still runs and
# exits at once): without it, rcorder gives no guarantee that pf.conf (with the three anchor lines of the setup
# guide) is loaded before jailopsd creates bridges and starts jails, and an anchor call that resolves to nothing
# yet falls through to whatever the administrator's own ruleset does next (design 18, the boot-time audit).
# "syslogd": the daemon logs to syslog, and in appliance mode the setup token goes there too.
#
# Add to /etc/rc.conf:
#   jailopsd_enable="YES"
#   jailopsd_web="YES"       (optional) serve the web console on this host, in a browser: it opens the TLS listener on port
#                            39110 unless listen.https.address is set. The console is in the binary and off by default; the
#                            API is the same either way. "NO" forces it off over the configuration. Unset: the configuration
#                            decides (web.enabled, default false).
#   jailops_appliance="YES"  (optional) appliance mode (docs/appliance.md), with jailops_appliance_modules: the daemon
#                            manages those modules besides host.manage.modules of jailopsd.yaml (the helper's own list
#                            decides what it changes). While no administrator exists, every start prints a new one-time
#                            setup token and the console's addresses on the system console and to syslog (authpriv,
#                            /var/log/auth.log); `jailops-priv setup-token` (as root) prints another.
# jailopsd runs as the unprivileged user jailops; everything that needs root is done by jailops_priv.
# Configuration: /usr/local/etc/jailops/jailopsd.yaml
#   service jailopsd checkconfig   validate the configuration
#   service jailopsd status        the process runs; GET /readyz says whether it can serve (docs/operations.md)
# There is no reload: the configuration is read at start (SIGHUP is ignored by design) and a renewed TLS
# certificate is picked up without a restart. Output goes to syslog (tag jailopsd).

. /etc/rc.subr

name="jailopsd"
rcvar="jailopsd_enable"
desc="JailOps daemon"

# daemon(8) writes both pid files as root, before it runs jailopsd as jailops: they live in /var/run, not in
# /var/run/jailops, which jailops may write to.
pidfile="/var/run/jailopsd.pid"
supervisor_pidfile="/var/run/jailopsd-daemon.pid"
procname="/usr/local/sbin/jailopsd"
command="/usr/sbin/daemon"
jailopsd_helper="/usr/local/libexec/jailops-priv"
jailopsd_console="/dev/console"

extra_commands="checkconfig"
checkconfig_cmd="jailopsd_checkconfig"
start_precmd="jailopsd_precmd"
start_postcmd="jailopsd_poststart"

# jailops_appliance_args prints the flag that passes jailops_appliance_modules on, nothing when appliance mode is off.
jailops_appliance_args()
{
	case "${jailops_appliance:-NO}" in
	[Yy][Ee][Ss]|[Tt][Rr][Uu][Ee]|[Oo][Nn]|1) ;;
	*) return 0 ;;
	esac
	_mods=$(echo ${jailops_appliance_modules:-all} | tr ' ' ',')
	case "${_mods}" in
	""|*[!a-z,]*) echo "jailops_appliance_modules: module names only (identity firewall), not \"${jailops_appliance_modules}\"" >&2; return 1 ;;
	esac
	echo "-appliance-modules ${_mods}"
}

jailopsd_checkconfig()
{
	su -m ${jailopsd_runas} -c "${procname} -config ${jailopsd_config} ${jailopsd_extra} -check-config"
}

jailopsd_precmd()
{
	install -d -m 1771 -o root -g jailops /var/run/jailops
	# refuse to start with a configuration that does not validate
	jailopsd_checkconfig >/dev/null || return 1
}

# Appliance mode: while no administrator exists, a new setup token and the console's addresses go to the system
# console (and to the terminal of `service jailopsd start`) and to syslog, authpriv. Nothing once one exists.
jailopsd_poststart()
{
	[ -n "${jailopsd_appliance}" ] || return 0
	_out=$(${jailopsd_helper} setup-token -wait 30s -syslog 2>/dev/null) || return 0
	echo "${_out}" > ${jailopsd_console}
	[ -n "${rc_fast}" ] || echo "${_out}"
}

# (not jailopsd_user: rc.subr would run the whole command as that user with su)
# rc.conf may set jailopsd_config and jailopsd_runas: read them before anything is derived from them
load_rc_config $name
: ${jailopsd_enable:="NO"}
: ${jailopsd_config:="/usr/local/etc/jailops/jailopsd.yaml"}
: ${jailopsd_runas:="jailops"}

# -p: pid of jailopsd itself (rc status and stop use it); -P: the supervisor, which exits with it.
jailopsd_extra=""
case "${jailopsd_web:-}" in
[Yy][Ee][Ss]) jailopsd_extra="-web" ;;
[Nn][Oo]) jailopsd_extra="-no-web" ;;
esac
jailopsd_appliance=$(jailops_appliance_args) || err 1 "invalid jailops_appliance_modules"
jailopsd_extra="${jailopsd_extra} ${jailopsd_appliance}"
command_args="-f -S -T jailopsd -u ${jailopsd_runas} -p ${pidfile} -P ${supervisor_pidfile} ${procname} -config ${jailopsd_config} ${jailopsd_extra}"
required_files="${jailopsd_config}"

run_rc_command "$1"
